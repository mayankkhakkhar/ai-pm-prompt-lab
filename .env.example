# MiniMax API
# Get your API key from the MiniMax platform dashboard
MINIMAX_API_KEY=your-minimax-key-here
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7

# Available models (verified Sept 2026):
#   MiniMax-M3              ← latest, has reasoning/thinking, expensive
#   MiniMax-M2.7            ← default for this sprint, good price/perf
#   MiniMax-M2.7-highspeed  ← faster M2.7, slightly lower quality
#   MiniMax-M2.5
#   MiniMax-M2.5-highspeed
#   MiniMax-M2.1
#   MiniMax-M2.1-highspeed
#   MiniMax-M2              ← oldest supported
#
# Cost tip: M2.7 is ~3-5x cheaper than M3. Use M3 only when you need
# the reasoning quality (e.g., complex multi-step tasks). For most of
# Phase 1's eval work, M2.7 is the right choice.