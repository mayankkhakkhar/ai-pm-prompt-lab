# MiniMax API
# Get your API key from the MiniMax platform dashboard
MINIMAX_API_KEY=your-minimax-key-here
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# Available models (verified Sept 2026):
#   MiniMax-M3              ← latest, default, has reasoning/thinking
#   MiniMax-M2.7            ← previous gen
#   MiniMax-M2.7-highspeed  ← faster M2.7
#   MiniMax-M2.5
#   MiniMax-M2.5-highspeed
#   MiniMax-M2.1
#   MiniMax-M2.1-highspeed
#   MiniMax-M2              ← oldest supported